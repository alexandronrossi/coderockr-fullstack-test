                            "query": [],
                            "raw": "{{baseUrl}}\/api\/health"
                        },
                        "method": "GET",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application\/json"
                            },
                            {
                                "key": "Accept",
                                "value": "application\/json"
                            }
                        ],
                        "body": null,
                        "description": "Returns a simple payload so clients and Scribe can verify the API is reachable.",
                        "auth": {
                            "type": "noauth"
                        }
                    },
                    "response": [
                        {
                            "header": [],
                            "code": 200,
                            "body": "{\"status\": \"ok\"}",
                            "name": "ok"
                        }
                    ]
                }
            ]
        }
    ],
